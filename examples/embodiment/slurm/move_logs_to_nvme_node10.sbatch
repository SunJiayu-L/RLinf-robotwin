echo "[move-logs] Directories to move: ${#MOVE_DIRS[@]}"
echo ""

TOTAL_MOVED=0
SKIPPED=0
ERRORS=0

for d in "${MOVE_DIRS[@]}"; do
    SRC="${LOGS_DIR}/${d}"
    DST="${NVME_LOGS}/${d}"
    if [[ ! -d "${SRC}" ]]; then
        echo "[SKIP] not found: ${d}"
        ((SKIPPED++)) || true
        continue
    fi
    if [[ -d "${DST}" ]]; then
        echo "[SKIP] already in nvme: ${d}"
        ((SKIPPED++)) || true
        continue
    fi
    SIZE=$(du -sh "${SRC}" 2>/dev/null | cut -f1)
    echo "[copy] ${d}  (${SIZE})"
    if rsync -a --info=progress2 "${SRC}/" "${DST}/"; then
        echo "[copy] OK: ${d}"
        ((TOTAL_MOVED++)) || true
    else
        echo "[ERROR] Failed to copy: ${d}"
        ((ERRORS++)) || true
    fi
done

echo ""
echo "[move-logs] Summary: ${TOTAL_MOVED} copied, ${SKIPPED} skipped, ${ERRORS} errors"
echo ""
echo "[move-logs] /nvme after copy:"
df -h /nvme
du -sh "${NVME_LOGS}/" 2>/dev/null
echo ""
echo "[move-logs] petrelfs logs/ current size:"
du -sh "${LOGS_DIR}/" 2>/dev/null
echo ""
echo "======================================================================"
echo "NEXT STEPS — after verifying backup above is complete:"
echo "  Run the following to delete from petrelfs and reclaim space:"
echo ""
echo "  LOG_NVME=${NVME_LOGS}"
echo "  for d in \$(ls \${LOG_NVME}/); do"
echo "    rm -rf ${LOGS_DIR}/\${d}"
echo "    echo \"Deleted: \${d}\""
echo "  done"
echo "======================================================================"
echo "[move-logs] DONE at $(date)"
