#!/bin/bash
#SBATCH -p wam_data
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH -J move-logs-to-nvme
#SBATCH -o /mnt/petrelfs/muyao/jiayusun/RLinf-robotwin/slurm_logs/move_logs_to_nvme-%j.out
#SBATCH --time=2-00:00:00
#SBATCH --nodelist=SH-IDCA1404-10-140-54-10

set -euo pipefail

NODE=$(hostname)
LOGS_DIR=/mnt/petrelfs/muyao/jiayusun/RLinf-robotwin/logs
NVME_LOGS=/nvme/jiayusun/data_backup/logs
mkdir -p "${NVME_LOGS}"

echo "[move-logs] Running on: ${NODE}  job: ${SLURM_JOB_ID}  $(date)"
echo ""
echo "[move-logs] /nvme current state:"
df -h /nvme
echo ""
echo "[move-logs] Existing backup contents:"
du -sh /nvme/jiayusun/data_backup/*/ 2>/dev/null || true
echo ""

